# Public origin and operator contact. Do not use preview URLs as canonicals.
SITE_URL=
# Enable only on the public deployment; previews stay noindex by default.
INDEXING_ENABLED=false
CONTACT_EMAIL=
OPERATOR_NAME=

# Free official-source collection works without search or model API keys.
# local: app runs collection against its persistent cache.
# github: app reads the scheduled public feed from promotion-data.
PROMOTION_FEED=local
PROMOTION_FEED_REPOSITORY=thembaxx/procodiapp

# Optional Brave Search API key for discovering current retailer pages and
# third-party review leads. Set on the Actions discovery environment.
BRAVE_SEARCH_API_KEY=
# Optional Treg search. Keep TREG_TOKEN on the Actions discovery environment;
# user-refresh-triggered scans never perform web search.
# DISCOVERY_SEARCH_MODE: none | brave | treg | both (default: brave).
DISCOVERY_SEARCH_MODE=brave
TREG_TOKEN=
# Optional for an identity token; not needed for a per-org token.
TREG_ORG=
# Hard cap per routed call; the default is $0.01, never the treg $1 default.
TREG_MAX_COST_USD=0.01
# In-memory cap per scheduled scan, not a durable per-day spending limit.
TREG_SCAN_BUDGET_USD=0.12
TREG_MAX_CALLS_PER_SCAN=12
# Review-only fallback for allowed JavaScript-only official pages.
PROMOTION_TREG_EXTRACT_FALLBACK=false
# Browser rendering is intended for the scheduled collector, not Vercel functions.
PROMOTION_BROWSER_FALLBACK=false
# Optional server-only fine-grained GitHub token (Actions: write) to queue
# workflow_dispatch runs on refresh; do not set NEXT_PUBLIC_ prefix.
GITHUB_DISPATCH_TOKEN=

# Optional free CJ publisher fallback. Set all three together, or leave all blank.
# IDs are approved South African advertisers, mapped to the six store IDs.
# Example shape only (use real approved IDs): {"pnp":["12345"]}
CJ_API_TOKEN=
CJ_WEBSITE_ID=
CJ_ADVERTISERS=

# Local or single-node persistent storage. Mount this path on a persistent volume.
DATA_DIR=.data

# Optional Supabase storage for multi-instance or serverless deployments.
# Run supabase/schema.sql first. These credentials are SERVER ONLY.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required in production: a separate random secret (32+ characters) for daily HMAC rate-limit identifiers.
RATE_LIMIT_SECRET=

# Optional for an alternative HTTP scheduler; the Actions publisher doesn't use it.
# Generate 32+ random characters for GET /api/cron with Authorization: Bearer <secret>.
CRON_SECRET=

# Set true only behind a trusted ingress that overwrites x-forwarded-for.
TRUST_PROXY=false

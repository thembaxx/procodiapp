{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coupon-scraper",
  "account_id": "4558b6cb691038495ac4966102bdb898",
  "main": "src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "browser": { "binding": "BROWSER" },
  "vars": {
    "FIRECRAWL_ENABLED": "true",
    "FIRECRAWL_DAILY_LIMIT": "6",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coupons",
      "database_id": "2bd77bf9-c65b-4d90-a608-f3973776143a",
    },
  ],
  "triggers": { "crons": ["0 */12 * * *"] },
  "queues": {
    "producers": [{ "binding": "SCRAPE_QUEUE", "queue": "scrape-jobs" }],
    "consumers": [
      {
        "queue": "scrape-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 2,
        "retry_delay": 60,
        "dead_letter_queue": "scrape-dlq",
      },
    ],
  },
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coupon-scraper",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "browser": { "binding": "BROWSER" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "coupons",
    "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
  }],
  "triggers": { "crons": ["0 */12 * * *"] },
  "queues": {
    "producers": [{ "binding": "SCRAPE_QUEUE", "queue": "scrape-jobs" }],
    "consumers": [{
      "queue": "scrape-jobs",
      "max_batch_size": 1,
      "max_batch_timeout": 1,
      "max_concurrency": 3,
      "max_retries": 2,
      "dead_letter_queue": "scrape-dlq"
    }]
  }
}
